		<SENSOR_ENVIRONMENT_DATA value="false"/><!-- optional-->
		<SENSOR_HVAC_DATA value="false"/><!-- optional-->
		<SENSOR_DRIVING_STATUS_DATA value="true"/><!-- required-->
