		<Resolution720P value="false">
			<fps value="30"/>
			<WidthMargin value="0"/>
			<HeightMargin value="0"/>
			<Density value="0"/>
			<RealDensity value="0"/>
		</Resolution720P>
	</Display>
	<Audio>
		<MediaStream value="true"/><!-- optional-->
		<NavStream value="true"/><!-- optional-->
		<SystemStream value="false"/><!-- optional-->
	</Audio>
	<Input>
		<TouchScreen value="true">
			<ScreenType value="2"/><!-- capacitive:1 resistive:2-->
			<ScreenWidth value="1024"/>
			<ScreenHeight value="600"/>
