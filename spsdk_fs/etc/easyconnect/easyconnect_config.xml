		<MajorVersion value="2"/>
		<MinorVersion value="1"/>
		<ReleaseVersion value="3"/>
	</ModuleInfo>
	<Connection>
		<ProbeTimeout value="15"/>
	</Connection>
	<CarInfo>
		<VehicleMake value="Rolls-Royce"/>
		<VehicleModel value="Phantom"/>
		<VehicleYear value="2016"/>
		<HeadUnitMake value="XXCompany"/>
		<HeadUnitModel value="XXModel"/>
		<HeadUnitSwBuild value="XXOS"/>
		<HeadUnitSwVersion value="0.1"/>
	</CarInfo>
	<DisplayWindow><!-- Head Unit side configuration-->
		<X_Coordinate value="0"/>
		<Y_Coordinate value="0"/>
