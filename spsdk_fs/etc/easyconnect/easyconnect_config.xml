			<KEYCODE_NAVIGATION value="false"/>
			<KEYCODE_TEL value="false"/>
			<KEYCODE_ENTER value="false"/>
            <KEYCODE_ROTARY_CONTROLLER value="false"/>
		</Key>
	</Input>
	<Sensor>
		<SENSOR_LOCATION value="true"/><!-- if the HU has navigation sensors, must be provided-->
