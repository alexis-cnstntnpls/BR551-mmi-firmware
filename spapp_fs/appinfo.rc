on app_laterc
    export SP_CONFIG_MODEL_PLATFORM_CFG 4RlsCode_8368_XU_demov1.0_openall_cfg
    export SP_CONFIG_GLB_GMNCFG_MODEL_UBOOT_CFG gemini_8368_XU_evb_def_config
    export SP_CONFIG_GLB_GMNCFG_MODEL_ECOS_CFG sunplus/gemini_disc
    export SP_CONFIG_GLB_GMNCFG_MODEL_KERNEL_CFG gemini_8368_XU_defconfig
    export SP_CONFIG_GLB_GMNCFG_MODEL_SDK_CFG gemini_servo_cfg
    export SP_CONFIG_GLB_GMNCFG_MODEL_APP_CFG sunplus/sunplus_XU_demo_openallfunc

service mcusrv /application/bin/mcusrv 3 115200
    console

on property:ro.start.Launcher=1
   start mcusrv

on property:ro.start.ncLauncher=1
   start mcusrv

on property:ro.start.tdLauncher=1
   start mcusrv

